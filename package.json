{
  "name": "maguilanote",
  "version": "1.1.0",
  "description": "Visual workspace boards for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/copy-to-vault.mjs",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "20.11.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.8.7",
    "typescript": "5.4.2",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "perfect-freehand": "1.2.3"
  }
}
